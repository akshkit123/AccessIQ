# AccessIQ Environment Configuration Template
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL / SQLite fallback)
# Set USE_POSTGRESQL=True to connect to your PostgreSQL instance
USE_POSTGRESQL=False
DB_NAME=accessiq_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

# Biometrics / Face Engine
DEEPFACE_MODEL=VGG-Face
DEEPFACE_BACKEND=retinaface
DEEPFACE_METRIC=cosine
FACE_SIMILARITY_THRESHOLD=0.40
